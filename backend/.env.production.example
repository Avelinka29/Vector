VECTOR_ENVIRONMENT=production
VECTOR_DATABASE_URL=postgresql+asyncpg://vector:CHANGE_ME@postgres:5432/vector
VECTOR_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
VECTOR_ALLOWED_ORIGINS=https://example.by
VECTOR_WEB_APP_URL=https://example.by
VECTOR_PUBLIC_APP_URL=vector://auth

VECTOR_SMTP_HOST=
VECTOR_SMTP_PORT=587
VECTOR_SMTP_USERNAME=
VECTOR_SMTP_PASSWORD=
VECTOR_SMTP_FROM_EMAIL=support@example.by
VECTOR_SMTP_USE_TLS=true
VECTOR_SMTP_USE_SSL=false

VECTOR_OPENROUTER_API_KEY=
VECTOR_OPENROUTER_MODEL=openrouter/free
VECTOR_ASSISTANT_TIMEOUT_SECONDS=20
VECTOR_ASSISTANT_RECOMMENDATION_TIMEOUT_SECONDS=10
VECTOR_FIREBASE_SERVICE_ACCOUNT_PATH=
VECTOR_GOOGLE_CLIENT_ID=
